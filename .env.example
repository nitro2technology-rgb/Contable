# --- Base de datos (Neon) -------------------------------------------------
# Cadena "pooled" (con -pooler en el host). La usa la app en runtime.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Cadena directa (sin -pooler). La usan las migraciones de Prisma.
DIRECT_URL="postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Acceso ---------------------------------------------------------------
# Contraseña compartida por los socios para entrar al panel.
APP_PASSWORD="cambia-esta-clave"
# Secreto para firmar la cookie de sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="cambia-este-secreto-largo-y-aleatorio"
